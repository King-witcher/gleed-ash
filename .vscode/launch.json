{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug",
      "type": "lldb",
      "request": "launch",
      "cargo": {
        "args": ["run"],
        "cwd": "${workspaceFolder}",
      }
    },
    {
      "name": "Release",
      "type": "lldb",
      "request": "launch",
      "cargo": {
        "args": ["run", "--release"],
        "cwd": "${workspaceFolder}",
      }
    },
  ]
}
