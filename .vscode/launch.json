{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run (Debug)",
      // "lldb" = extensão CodeLLDB. Lê o PDB gerado pelo msvc target do rustc.
      "type": "lldb",
      "request": "launch",
      "program": "${workspaceFolder}/target/debug/ash-engine.exe",
      "cwd": "${workspaceFolder}",
      "terminal": "external",
      "preLaunchTask": "Cargo Build (Debug)"
    },
    {
      "name": "Run (Release)",
      "type": "lldb",
      "request": "launch",
      "program": "${workspaceFolder}/target/release/ash-engine.exe",
      "cwd": "${workspaceFolder}",
      "terminal": "external",
      "preLaunchTask": "Cargo Build (Release)"
    }
  ]
}
