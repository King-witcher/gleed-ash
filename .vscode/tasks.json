{
  "version": "2.0.0",
  "options": {
    "cwd": "${workspaceFolder}"
  },
  "presentation": {
    "panel": "dedicated",
    "clear": true
  },
  "tasks": [
    {
      "label": "cargo test",
      "detail": "Run the workspace tests",
      "icon": { "id": "beaker", "color": "terminal.ansiMagenta" },
      "type": "shell",
      "command": "cargo",
      "args": ["test", "--workspace"],
      "problemMatcher": ["$rustc"],
      "group": { "kind": "test", "isDefault": true }
    },
    {
      "label": "cargo build",
      "detail": "Run the workspace tests",
      "icon": { "id": "build", "color": "terminal.ansiWhite" },
      "type": "shell",
      "command": "cargo",
      "args": ["build", "--workspace"],
      "problemMatcher": ["$rustc"],
      "group": { "kind": "build", "isDefault": true }
    },
  ]
}
